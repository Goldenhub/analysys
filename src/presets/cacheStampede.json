        "position": { "x": 50, "y": 200 },
        "config": {
          "rps": 300,
          "distribution": "POISSON",
          "spikeMultiplier": 1,
          "spikeDurationSec": 0
        }
      },
      {
        "id": "lb-1",
        "nodeType": "LOAD_BALANCER",
        "label": "Load Balancer",
        "position": { "x": 250, "y": 200 },
        "config": {
          "algorithm": "LEAST_CONNECTIONS",
          "healthCheckIntervalMs": 3000,
          "evictionThreshold": 0.85
        }
      },
      {
        "id": "app-1",
        "nodeType": "APP_SERVER",
        "label": "App Server 1",
        "position": { "x": 450, "y": 120 },
        "config": {
          "workerThreadPoolSize": 32,
          "requestQueueDepth": 200,
          "processingTimeMeanMs": 10,
          "processingTimeStdDevMs": 3
        }
      },
      {
        "id": "app-2",
        "nodeType": "APP_SERVER",
        "label": "App Server 2",
        "position": { "x": 450, "y": 280 },
        "config": {
          "workerThreadPoolSize": 32,
          "requestQueueDepth": 200,
          "processingTimeMeanMs": 10,
          "processingTimeStdDevMs": 3
        }
      },
      {
        "id": "cache-1",
        "nodeType": "CACHE",
        "label": "Redis Cache",
        "position": { "x": 700, "y": 200 },
        "config": {
          "hitRatio": 0.95,
          "evictionPolicy": "LRU",
          "accessLatencyMs": 2
        }
      },
      {
        "id": "db-1",
        "nodeType": "DATABASE",
        "label": "PostgreSQL",
        "position": { "x": 950, "y": 200 },
