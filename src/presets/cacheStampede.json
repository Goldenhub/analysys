{
  "schemaVersion": 1,
  "name": "Cache Stampede",
  "description": "Demonstrates cache stampede effect when cache is flushed under load. 300 RPS with 95% hit ratio suddenly drops to 0%, overwhelming the database.",
  "createdAt": "2024-01-01T00:00:00.000Z",
  "topology": {
