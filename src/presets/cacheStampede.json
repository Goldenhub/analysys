      { "id": "e-lb1-app2", "source": "lb-1", "target": "app-2", "protocol": "SYNC" },
      { "id": "e-app1-cache1", "source": "app-1", "target": "cache-1", "protocol": "SYNC" },
      { "id": "e-app2-cache1", "source": "app-2", "target": "cache-1", "protocol": "SYNC" },
